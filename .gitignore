# Machine-local config (games paths, etc.)
.env

# Rust
/target/
**/target/
/dist/

# Runtime output next to the binary / cwd.
iw4l-artifacts
iw4l.community.json
iw4l.community.*.tmp

# Agent working memory. None of it is the product: the artifacts, the externals,
# the agent clones and the RE tooling and its bases all stay on this machine.
/context/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Game data, from any install this fork reads. It is read at runtime and never
# committed; `make publish-check` refuses these too.
*.ff
*.iwd
*.iwi
*.upk
*.u
*.tfc
*.pck
*.bnk
*.wem
*.xex
*.xma
